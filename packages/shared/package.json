{
  "name": "@msauth/shared",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "MSAuth 共享层：常量、领域类型、Zod schema、统一错误码。纯 TS 源码，无构建产物。",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants.ts",
    "./errors": "./src/errors.ts",
    "./schemas/*": "./src/schemas/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^3.2.0"
  }
}
