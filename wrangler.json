{
	"compatibility_date": "2025-10-08",
	"main": "src/platform.ts",
	"name": "msauth",
	"upload_source_maps": true,
	"build": {
		"command": "npm run build:spa"
	},
	"vars": {
		"BETTER_AUTH_URL": "https://auth.msxor.com"
	},
	"routes": [
		{
			"pattern": "auth.msxor.com",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./frontend/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/.well-known/*"
		]
	},
	"secrets_store_secrets": [
		{
			"binding": "BETTER_AUTH_SECRET",
			"store_id": "a60718ab09e44b49b77925e063df42dc",
			"secret_name": "BETTER_AUTH_SECRET"
		},
		{
			"binding": "GITHUB_CLIENT_ID",
			"store_id": "a60718ab09e44b49b77925e063df42dc",
			"secret_name": "GITHUB_CLIENT_ID"
		},
		{
			"binding": "GITHUB_CLIENT_SECRET",
			"store_id": "a60718ab09e44b49b77925e063df42dc",
			"secret_name": "GITHUB_CLIENT_SECRET"
		},
		{
			"binding": "ADMIN_EMAIL",
			"store_id": "a60718ab09e44b49b77925e063df42dc",
			"secret_name": "ADMIN_EMAIL"
		}
	],
	"d1_databases": [
		{
			"binding": "AUTH_DB",
			"database_name": "msauth-db",
			"database_id": "bf5101d7-8f93-451e-9c10-73150ccc1c05"
		}
	],
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	"compatibility_flags": [
		"nodejs_compat"
	]
}
